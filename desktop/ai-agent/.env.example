nexus_ear=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama

# Backend and exact web origins allowed to pair with the local desktop agent.
VEDA_SERVER_URL=http://localhost:5000
VEDA_DESKTOP_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
