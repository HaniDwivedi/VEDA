# Keep secrets, dependencies, and generated outputs out of version control.
.env
.env.*
!.env.example
**/node_modules/
**/dist/
**/build/
desktop/release/
**/.gradle/
**/__pycache__/
**/*.py[cod]
**/*.spec
*.log
android/local.properties
android/app/release/
android/app/src/main/assets/public/
*.keystore
*.jks
desktop/ai-agent/temp_query.wav
