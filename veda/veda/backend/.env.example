# Backend signing keys must be distinct random strings of at least 32 characters.
ACCESS_TOKEN_SECRET=CHANGE_ME
REFRESH_TOKEN_SECRET=CHANGE_ME

# Redis stores short-lived QR challenges and paired-device routing sessions.
REDIS_URL=redis://127.0.0.1:6379

# Local desktop and mobile Vite origins; add deployed client origins when hosted.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174,https://localhost
PORT=5000
# Set only to the exact trusted reverse-proxy hop count or IP range, if deployed behind a proxy.
TRUST_PROXY=

# STUN is used by default. Configure both TURN values together when available.
STUN_URL=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
